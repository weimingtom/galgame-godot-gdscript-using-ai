{
  "id": "chapter2",
  "title": "第二章 · 测验前夕",
  "bgm": "res://assets/audio/bgm/classroom.wav",
  "nodes": [
    {
      "type": "bgm",
      "path": "res://assets/audio/bgm/classroom.wav",
